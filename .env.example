APP_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
TOKEN_PEPPER=replace-with-at-least-32-random-characters-in-production
AI_PROVIDER=groq
AI_MODEL=replace-with-a-model-supported-by-your-provider
GROQ_API_KEY=replace-me
NVIDIA_API_KEY=replace-me
# AI_BASE_URL may override the OpenAI-compatible HTTPS endpoint.
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_JSON_MODE=json_object
AI_TIMEOUT_SECONDS=60
AI_MAX_ATTEMPTS=3
AI_BACKOFF_BASE_SECONDS=1
AI_BACKOFF_MAX_SECONDS=20
AI_MAX_OUTPUT_TOKENS=3000
AI_MAX_INPUT_CHARS=60000
MAX_REQUEST_BYTES=125829120
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=30
MAX_PDF_TEXT_CHARS=300000
PDF_PARSE_TIMEOUT_SECONDS=20
MIN_EXTRACTED_CHARS=50
MAX_JD_CHARS=20000
MAX_RESUMES_PER_JOB=10
JOB_LEASE_SECONDS=180
JOB_HEARTBEAT_SECONDS=45
JOB_MAX_ATTEMPTS=3
WORKER_POLL_SECONDS=2
JOB_RETRY_BASE_SECONDS=5
JOB_RETRY_MAX_SECONDS=300
WORKER_SHUTDOWN_GRACE_SECONDS=20
RETENTION_DAYS=14
ACCESS_TOKEN_TTL_HOURS=336
POLL_AFTER_SECONDS=2
ALLOWED_ORIGINS=
TRUSTED_PROXY_CIDRS=
LOG_LEVEL=INFO
