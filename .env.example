# Local defaults for the public, stateless demo; secret values are intentionally blank.
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
CORS_ORIGINS=[]

# Optional: only the retained tenant-scoped APIs and durable worker need Supabase.
# The public demo never receives these keys and never persists screening data.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESUME_MAX_BYTES=10485760
SIGNED_URL_TTL_SECONDS=60
SCREENING_WORKER_ENABLED=false
PDF_MAX_PAGES=100
OCR_MAX_PAGES=20
OCR_TIMEOUT_SECONDS=15
OCR_LANGUAGE=eng
TESSERACT_CMD=
AI_TIMEOUT_SECONDS=45
AI_MAX_ATTEMPTS=2
CLASSIFICATION_CONSIDERED_MIN=40
CLASSIFICATION_PRIORITY_MIN=75

# Required to run public demo analysis; server-side only, never expose in browser code.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
NVIDIA_API_KEY=
