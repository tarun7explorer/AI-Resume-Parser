# Local defaults; copy to .env. Secret values below are intentionally blank.
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
CORS_ORIGINS=[]

# Browser requests use the public key and verified recruiter bearer token.
# The service role is restricted to the optional server-side screening worker.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESUME_MAX_BYTES=10485760
SIGNED_URL_TTL_SECONDS=60
SCREENING_WORKER_ENABLED=false
PDF_MAX_PAGES=100
OCR_MAX_PAGES=20
OCR_TIMEOUT_SECONDS=15
OCR_LANGUAGE=eng
TESSERACT_CMD=
AI_TIMEOUT_SECONDS=45
AI_MAX_ATTEMPTS=2
CLASSIFICATION_CONSIDERED_MIN=40
CLASSIFICATION_PRIORITY_MIN=75

# Optional provider credentials; never expose these to browser code.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
NVIDIA_API_KEY=
